@model LmsModernApp.Models.BorrowerExtendedViewModel
@{
    ViewData["Title"] = "Borrower Courses & Periods";
}

<partial name="_DashboardHeader" />

<div class="row mt-3">
    <partial name="_UsersSidebar" />

    <div class="col-md-10">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="text-primary mb-0"><i class="bi bi-mortarboard me-2"></i>Groups, Classes & Courses</h4>
            <a asp-action="@(ViewBag.Origin ?? "UsersMoreOptions")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="fw-bold">Current Assignments for @Model.Borrower.BorGiven @Model.Borrower.BorSurname</span>
                <div>
                    <span class="badge bg-primary">Group: @Model.Borrower.BorGroup</span>
                    <span class="badge bg-info text-dark">Class: @Model.Borrower.BorClass</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Course Code</th>
                                <th>From Date</th>
                                <th>To Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CoursePeriods != null && Model.CoursePeriods.Any())
                            {
                                foreach (var period in Model.CoursePeriods)
                                {
                                    <tr>
                                        <td class="fw-bold">@period.BorCoCode</td>
                                        <td>@period.BorCpDateFrom.ToString("d")</td>
                                        <td>@period.BorCpDateTo.ToString("d")</td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-danger btn-sm" disabled><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No historical course assignments found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="alert alert-secondary shadow-sm">
            <h5><i class="bi bi-plus-circle me-2"></i>Add Course Assignment</h5>
            <p class="small text-muted mb-3">Historical assignments for academic tracking. For live enrolment, use the <strong>Education Management</strong> portal.</p>
            <form class="row g-3 opacity-75">
                <div class="col-md-4">
                    <label class="form-label small">Course Code</label>
                    <input type="text" class="form-control form-control-sm" placeholder="e.g. ENG101" disabled>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">From Date</label>
                    <input type="date" class="form-control form-control-sm" disabled>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">To Date</label>
                    <input type="date" class="form-control form-control-sm" disabled>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-primary btn-sm w-100" disabled>Add</button>
                </div>
            </form>
        </div>
    </div>
</div>
