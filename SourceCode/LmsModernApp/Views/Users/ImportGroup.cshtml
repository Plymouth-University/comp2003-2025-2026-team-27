@{
    ViewData["Title"] = "Import Multiple User Groups";
}

<partial name="_DashboardHeader" />

<div class="row mt-4">
    <partial name="_UsersSidebar" />

    <div class="col-md-10">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Import">Import Hub</a></li>
                <li class="breadcrumb-item active" aria-current="page">Import Groups</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-info">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Update User Groups via File</h5>
            </div>
            <div class="card-body">
                <form asp-action="ProcessImportGroup" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="groupFile" class="form-label">Mapping File (CSV)</label>
                        <input type="file" class="form-control" id="groupFile" name="groupFile" accept=".csv">
                        <div class="form-text text-muted">
                            CSV format: [Barcode],[New Group Code]
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Import" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-info text-white">Update Groups</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>