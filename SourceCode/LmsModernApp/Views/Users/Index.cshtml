@model LmsModernApp.Models.BorrowerMaintenanceViewModel
@{
    ViewData["Title"] = "Users";
}

<partial name="_DashboardHeader" />

<div class="row mt-4">
    <partial name="_UsersSidebar" />

    <div class="col-md-10">
        <h2>Users</h2>
        <hr />

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span>Borrower Maintenance</span>
                <form asp-action="Search" method="post" class="d-flex gap-2">
                    <input type="text" name="barcode" class="form-control form-control-sm" placeholder="Scan Barcode..." autofocus />
                    <button type="submit" class="btn btn-light btn-sm">Find</button>
                </form>
            </div>
            <div class="card-body">
                <form asp-action="Save" method="post">
                    <input type="hidden" asp-for="Borrower.BorNo" />
                    
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label asp-for="Borrower.BorBarNo" class="form-label">Barcode</label>
                            <input asp-for="Borrower.BorBarNo" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Borrower.BorTitle" class="form-label">Title</label>
                            <select asp-for="Borrower.BorTitle" class="form-select">
                                <option value="">-- Select --</option>
                                @foreach (var item in Model.Titles)
                                {
                                    <option value="@item.Code">@item.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Borrower.BorSurname" class="form-label">Surname</label>
                            <input asp-for="Borrower.BorSurname" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Borrower.BorGiven" class="form-label">Given Name</label>
                            <input asp-for="Borrower.BorGiven" class="form-control" required />
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Borrower.BorType" class="form-label">Type</label>
                            <select asp-for="Borrower.BorType" class="form-select">
                                @foreach (var item in Model.BorrowerTypes)
                                {
                                    <option value="@item.Code">@item.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Borrower.BorGroup" class="form-label">Group</label>
                            <select asp-for="Borrower.BorGroup" class="form-select">
                                @foreach (var item in Model.BorrowerGroups)
                                {
                                    <option value="@item.Code">@item.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Borrower.BorClass" class="form-label">Class</label>
                            <select asp-for="Borrower.BorClass" class="form-select">
                                @foreach (var item in Model.BorrowerClasses)
                                {
                                    <option value="@item.Code">@item.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Borrower.BorStatus" class="form-label">Status</label>
                            <select asp-for="Borrower.BorStatus" class="form-select">
                                @foreach (var item in Model.BorrowerStatuses)
                                {
                                    <option value="@item.Code">@item.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Borrower.BorEmail" class="form-label">Email</label>
                            <input asp-for="Borrower.BorEmail" type="email" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Borrower.BorLocation" class="form-label">Location</label>
                            <select asp-for="Borrower.BorLocation" class="form-select">
                                @foreach (var item in Model.Locations)
                                {
                                    <option value="@item.Code">@item.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Borrower.BorPin" class="form-label">PIN</label>
                            <input asp-for="Borrower.BorPin" class="form-control" type="password" />
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary">Save Borrower</button>
                            <a asp-action="New" class="btn btn-outline-secondary">New Record</a>
                            @if (Model.Borrower.BorNo > 0)
                            {
                                <button type="button" class="btn btn-outline-danger float-end" data-bs-toggle="modal" data-bs-target="#deleteModal">Delete</button>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.Borrower.BorNo > 0)
        {
            <!-- Delete Confirmation Modal -->
            <div class="modal fade" id="deleteModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirm Delete</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to delete @Model.Borrower.BorGiven @Model.Borrower.BorSurname?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <form asp-action="Delete" method="post">
                                <input type="hidden" name="id" value="@Model.Borrower.BorNo" />
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</div>