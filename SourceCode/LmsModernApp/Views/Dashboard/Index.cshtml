@model LmsModernApp.Models.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
    var labelsJson = JsonSerializer.Serialize(Model.Labels);
    var valuesJson = JsonSerializer.Serialize(Model.Values);
}

<div class="text-center">
    <h1 class="display-4">Welcome to your Dashboard</h1>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Total Books</h5>
                <p class="card-text display-3">@Model.TotalBookCount</p>
                <a href="#" class="btn btn-primary">View all books</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Total Members</h5>
                <p class="card-text display-3">@Model.TotalMemberCount</p>
                <a href="#" class="btn btn-primary">View all members</a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <!-- LEFT HALF -->
        <div class="col-12 col-lg-6">
            <div class="p-3 border rounded">
                <h4>Left Panel</h4>
                <p>This area is reserved for your other dashboard content.</p>
            </div>
        </div>

        <!-- RIGHT HALF -->
        <div class="col-12 col-lg-6">
            <div class="p-3 border rounded">
                <h4 class="mb-3">Issues by Subject Group</h4>

                <form method="get" class="d-flex align-items-end gap-2 mb-3">
                    <div>
                        <label class="form-label mb-1">Issue dates between</label>
                        <input class="form-control" type="date" name="from" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label class="form-label mb-1">&nbsp;</label>
                        <input class="form-control" type="date" name="to" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <button class="btn btn-primary" type="submit">Search</button>
                    </div>
                </form>

                <div id="jsStatus" class="alert alert-secondary">
                    JavaScript status: <strong>waiting</strong>
                </div>

                <div style="height: 420px;">
                    <canvas id="issuesByGroupChart"></canvas>
                </div>

                <div class="mt-2 small text-muted">
                    Labels count: @(Model.Labels?.Count ?? 0) |
                    Values count: @(Model.Values?.Count ?? 0)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Visible proof JS executed:
        const statusBox = document.getElementById("jsStatus");
        statusBox.className = "alert alert-success";
        statusBox.innerHTML = 'JavaScript status: <strong>running</strong>';

        console.log("Dashboard scripts running ?");
        console.log("Chart.js loaded?", typeof Chart !== "undefined");

        const labels = @Html.Raw(labelsJson);
        const values = @Html.Raw(valuesJson);

        console.log("labels:", labels);
        console.log("values:", values);

        const canvas = document.getElementById('issuesByGroupChart');
        const ctx = canvas.getContext('2d');

        if (typeof Chart === "undefined") {
            statusBox.className = "alert alert-danger";
            statusBox.innerHTML = 'JavaScript status: <strong>Chart.js NOT loaded</strong> (CDN blocked?)';
        } else {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Issues (count)',
                        data: values,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }
    </script>
    }