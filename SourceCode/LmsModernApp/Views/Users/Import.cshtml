@{
    ViewData["Title"] = "Import";
}

<partial name="_DashboardHeader" />

<div class="row mt-4">
    <partial name="_UsersSidebar" />

    <div class="col-md-10">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">User Import</h2>
        </div>
        <hr />

        <div class="row g-4">
            <!-- Import Using Template -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-primary">
                    <div class="card-body d-flex flex-column text-center">
                        <div class="mb-3 text-primary">
                            <i class="bi bi-file-earmark-spreadsheet fs-1"></i>
                        </div>
                        <h5 class="card-title">Import by Template</h5>
                        <p class="card-text small text-muted flex-grow-1">
                            Import user details using a predefined mapping template.
                        </p>
                        <a asp-action="ImportTemplate" class="btn btn-primary mt-auto">Go to Import</a>
                    </div>
                </div>
            </div>

            <!-- Import Pictures -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-success">
                    <div class="card-body d-flex flex-column text-center">
                        <div class="mb-3 text-success">
                            <i class="bi bi-person-bounding-box fs-1"></i>
                        </div>
                        <h5 class="card-title">Import Pictures</h5>
                        <p class="card-text small text-muted flex-grow-1">
                            Batch upload user profile pictures from a ZIP archive.
                        </p>
                        <a asp-action="ImportPictures" class="btn btn-success mt-auto">Go to Import</a>
                    </div>
                </div>
            </div>

            <!-- Import Groups -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-info">
                    <div class="card-body d-flex flex-column text-center">
                        <div class="mb-3 text-info">
                            <i class="bi bi-people fs-1"></i>
                        </div>
                        <h5 class="card-title">Import Groups</h5>
                        <p class="card-text small text-muted flex-grow-1">
                            Update group assignments for multiple users at once.
                        </p>
                        <a asp-action="ImportGroup" class="btn btn-info mt-auto text-white">Go to Import</a>
                    </div>
                </div>
            </div>

            <!-- Import Classes -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-warning">
                    <div class="card-body d-flex flex-column text-center">
                        <div class="mb-3 text-warning">
                            <i class="bi bi-mortarboard fs-1"></i>
                        </div>
                        <h5 class="card-title">Import Classes</h5>
                        <p class="card-text small text-muted flex-grow-1">
                            Batch update user class designations from a mapping file.
                        </p>
                        <a asp-action="ImportClass" class="btn btn-warning mt-auto text-dark">Go to Import</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
