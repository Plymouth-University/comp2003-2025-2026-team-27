@model LmsModernApp.ViewModels.CatalogueUploadPictureViewModel
@{
    ViewData["Title"] = "Upload Picture";
    Layout = "_Layout";
}

<partial name="_DashboardHeader" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap');

    .upload-wrap, .upload-wrap * {
        font-family: 'DM Sans', sans-serif;
        box-sizing: border-box;
    }

    .upload-wrap {
        max-width: 560px;
        margin: 32px auto;
    }

    .card {
        background: #fff;
        border: 1px solid #dde3f0;
        border-radius: 6px;
        box-shadow: 0 4px 16px rgba(26,79,186,.12);
        overflow: hidden;
    }

    .card-header {
        background: #1f66d1;
        color: #fff;
        padding: 14px 20px;
        font-size: 15px;
        font-weight: 600;
    }

    .card-body {
        padding: 24px 24px 20px;
    }

    .record-info {
        margin-bottom: 20px;
        font-size: 13px;
        color: #6b7a99;
    }

        .record-info strong {
            color: #1e2a45;
        }

    .current-pic {
        margin-bottom: 20px;
    }

        .current-pic img {
            max-width: 100%;
            max-height: 200px;
            border: 1px solid #dde3f0;
            border-radius: 4px;
            display: block;
            margin-bottom: 6px;
        }

        .current-pic .pic-label {
            font-size: 11px;
            color: #6b7a99;
        }

    .form-group {
        margin-bottom: 16px;
    }

        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 500;
            color: #6b7a99;
            margin-bottom: 5px;
        }

        .form-group input[type="file"] {
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            width: 100%;
            padding: 6px 8px;
            border: 1px solid #dde3f0;
            border-radius: 4px;
            background: #f8f9fc;
        }

    .validation-summary {
        color: #d11b2d;
        font-size: 13px;
        margin-bottom: 12px;
    }

    .btn-row {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .btn {
        padding: 7px 18px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-primary {
        background: #1f66d1;
        color: #fff;
        border: none;
    }

        .btn-primary:hover {
            background: #2b78ff;
        }

    .btn-secondary {
        background: #fff;
        color: #1f66d1;
        border: 1px solid #dde3f0;
    }

        .btn-secondary:hover {
            background: #f1f4fb;
        }
</style>

<div class="upload-wrap">
    <div class="card">
        <div class="card-header">Upload Picture — Ref No: @Model.CatNo</div>
        <div class="card-body">

            <div class="record-info">
                <strong>@Model.Title</strong><br />
                @Model.Author
            </div>

            @if (Model.HasPicture)
            {
                <div class="current-pic">
                    <img src="/Catalogue/Picture?catNo=@Model.CatNo&libGroup=@Model.LibGroup" alt="Current picture" />
                    <div class="pic-label">Current: @Model.PicFilename</div>
                </div>
            }

            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CatNo" value="@Model.CatNo" />
                <input type="hidden" name="LibGroup" value="@Model.LibGroup" />
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary">
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <div class="form-group">
                    <label>Select Image File</label>
                    <input type="file" name="picture" accept="image/*" />
                </div>

                <div class="btn-row">
                    <a href="@(Model.ReturnUrl ?? "/Catalogue/Index")" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>
