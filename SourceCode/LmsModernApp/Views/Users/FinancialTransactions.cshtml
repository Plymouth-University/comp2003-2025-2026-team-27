@model LmsModernApp.Models.BorrowerExtendedViewModel
@{
    ViewData["Title"] = "Financial Transactions";
}

<partial name="_DashboardHeader" />

<div class="row mt-3">
    <partial name="_UsersSidebar" />

    <div class="col-md-10">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="text-primary mb-0"><i class="bi bi-cash-coin me-2"></i>Financial Transactions</h4>
            <div>
                <button class="btn btn-primary btn-sm me-2" disabled><i class="bi bi-plus-circle"></i> Add Transaction</button>
                <a asp-action="@(ViewBag.Origin ?? "UsersMoreOptions")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <span class="fw-bold">Transaction History for @Model.Borrower.BorGiven @Model.Borrower.BorSurname (@Model.Borrower.BorBarNo)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <!-- Increased width to accommodate all legacy columns -->
                    <table class="table table-hover mb-0" style="min-width: 1200px;">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 100px;">Type</th>
                                <th style="width: 110px;">Date</th>
                                <th style="width: 80px;">Loc.</th>
                                <th style="width: 60px;">Qty</th>
                                <th class="text-end" style="width: 100px;">Charge (Debit)</th>
                                <th class="text-end" style="width: 100px;">Paid (Credit)</th>
                                <th style="width: 180px;">Comment</th>
                                <th style="width: 100px;">Item</th>
                                <th style="width: 200px;">Title</th>
                                <th style="width: 100px;">Inv. No</th>
                                <th style="width: 110px;">Inv. Date</th>
                                <th style="width: 100px;">Receipt No</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.FinanceTransactions != null && Model.FinanceTransactions.Any())
                            {
                                foreach (var tran in Model.FinanceTransactions)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@tran.FinType</span></td>
                                        <td>@tran.FinDate?.ToString("d")</td>
                                        <td>@tran.FinLoc</td>
                                        <td>@tran.FinQty</td>
                                        <td class="text-end fw-bold">@tran.FinValue?.ToString("N2")</td>
                                        <td class="text-end text-success">@tran.FinPaid?.ToString("N2")</td>
                                        <td class="small">@tran.FinComments</td>
                                        <td><code>@tran.FinItem</code></td>
                                        <td class="small">@tran.FinTitle</td>
                                        <td>@tran.FinInvNo</td>
                                        <td>@tran.FinInvDate?.ToString("d")</td>
                                        <td>@tran.FinReceipt</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="12" class="text-center py-4 text-muted">No financial transactions found for this borrower.</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="4" class="text-end">Current Balance:</td>
                                <td class="text-end text-danger">@Model.Borrower.BorOwing?.ToString("C")</td>
                                <td colspan="7"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        
        <div class="alert alert-info small shadow-sm">
            <i class="bi bi-info-circle me-2"></i> 
            This view displays all financial activity including fines, manual charges, and payments. Field editing is currently disabled in this migration phase.
        </div>
    </div>
</div>
