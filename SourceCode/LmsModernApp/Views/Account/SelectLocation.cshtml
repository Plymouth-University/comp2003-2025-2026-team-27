@model IEnumerable<Lms.Data.Models.Delocal.LibLocation>

@{
    ViewData["Title"] = "Select Working Location";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-5">
            <div class="card-body p-4">
                <h2 class="text-center mb-4">@ViewData["Title"]</h2>
                <p class="text-muted text-center">Please select the library you are working at today.</p>
                <hr />

                <form asp-action="SelectLocation" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    @if (ViewData["ReturnUrl"] != null)
                    {
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    }

                    <div class="mb-4">
                        <label for="llCode" class="form-label">Library Location</label>
                        <select name="llCode" id="llCode" class="form-select form-select-lg" required>
                            <option value="">-- Choose a Location --</option>
                            @foreach (var loc in Model)
                            {
                                <option value="@loc.LlCode">@loc.LlName (@loc.LlCode)</option>
                            }
                        </select>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Confirm Selection</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
