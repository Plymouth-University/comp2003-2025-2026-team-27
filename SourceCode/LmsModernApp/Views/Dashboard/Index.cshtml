@model LmsModernApp.Models.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";

    var labelsJson = JsonSerializer.Serialize(Model.Labels ?? new List<string>());
    var valuesJson = JsonSerializer.Serialize(Model.Values ?? new List<int>());
    var percentagesJson = JsonSerializer.Serialize(Model.Percentages ?? new List<double>());
    
    var trendsData = Model.Trends.Select(t => new {
        label = t.Label,
        dates = t.Points.Select(p => p.Date.ToString("yyyy-MM-dd")),
        counts = t.Points.Select(p => p.Count)
    });
    var trendsJson = JsonSerializer.Serialize(trendsData);
}

<partial name="_DashboardHeader" />

<div class="container-fluid mt-2">
    <div class="row g-3">
        <!-- LEFT COLUMN -->
        <div class="col-lg-6 d-flex flex-column gap-3">
            
            <!-- TOP LEFT: FILTERS + PIE CHART -->
            <div class="dash-panel">
                <div class="dash-panel-header px-2 py-1">
                    <span class="text-white small fw-bold">Distribution & Filters</span>
                </div>
                <div class="dash-panel-body p-2">
                    <div class="row g-2 mb-3 border-bottom pb-2">
                        <div class="col-md-3">
                            <label class="xxs-label">Display</label>
                            <select id="filterType" class="form-select form-select-sm">
                                <option value="Loan">Current Loans</option>
                                <option value="User">User Counts</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="xxs-label">Group By</label>
                            <select id="groupBy" class="form-select form-select-sm">
                                <option value="Class">Class</option>
                                <option value="Subject">Subject (Group)</option>
                                <option value="MemberType">Member Type</option>
                                <option value="CatalogueSubject">Catalogue Subject</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="xxs-label">User File</label>
                            <select id="fileNumber" class="form-select form-select-sm">
                                <option value="">-- All Users --</option>
                                @foreach (var file in Model.UserFiles)
                                {
                                    <option value="@file.FileNumber">@file.FileDesc</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3" id="overdueWrapper">
                            <label class="xxs-label">Status</label>
                            <div class="overdue-box p-1 rounded border d-flex align-items-center gap-2" style="background: #f8f9fa;">
                                <input class="form-check-input mt-0 border-secondary" type="checkbox" id="overdueOnly" />
                                <label class="small text-muted mb-0" for="overdueOnly" style="font-size: 0.75rem;">Overdue items only</label>
                            </div>
                        </div>
                    </div>
                    
                    <div style="height: 320px;">
                        <canvas id="pieChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- BOTTOM LEFT: DRILL DOWN -->
            <div class="dash-panel">
                <div class="dash-panel-header px-2 py-1 d-flex justify-content-between align-items-center">
                    <span id="drillDownTitle" class="text-white small fw-bold">Borrower Details</span>
                    <div id="drillDownActions" class="d-none">
                        <button class="btn btn-xxs btn-light py-0 px-1" style="font-size: 0.7rem;">Excel</button>
                    </div>
                </div>
                <div id="drillDownContainer" class="p-2" style="height: 550px; overflow-y: auto;">
                    <div class="text-center py-5 text-muted small italic">
                        Click on a chart segment to view member details.
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="col-lg-6 d-flex flex-column gap-3">
            
            <!-- TOP RIGHT: COMPARISON -->
            <div class="dash-panel">
                <div class="dash-panel-header px-2 py-1">
                    <span class="text-white small fw-bold">Comparison</span>
                </div>
                <div class="dash-panel-body p-2" style="height: 400px;">
                    <canvas id="barChart"></canvas>
                </div>
            </div>

            <!-- MIDDLE RIGHT: SECONDARY FILTERS + SEARCH -->
            <div class="card shadow-sm border p-2 bg-light">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="xxs-label">From Date</label>
                        <input id="fromDate" class="form-control form-control-sm" type="date" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label class="xxs-label">To Date</label>
                        <input id="toDate" class="form-control form-control-sm" type="date" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4 d-none" id="operatorWrapper">
                        <label class="xxs-label">Operator</label>
                        <select id="operatorName" class="form-select form-select-sm">
                            <option value="">-- All --</option>
                            @foreach (var op in Model.Operators)
                            {
                                <option value="@op.OperName">@op.OperName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button id="refreshBtn" class="btn btn-primary btn-sm w-100 fw-bold">Update All Graphs</button>
                    </div>
                </div>
            </div>

            <!-- BOTTOM RIGHT: TRENDS -->
            <div class="dash-panel">
                <div class="dash-panel-header px-2 py-1">
                    <span id="trendTitle" class="text-white small fw-bold">Activity Trends</span>
                </div>
                <div class="dash-panel-body p-2" style="height: 550px;">
                    <canvas id="lineChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dash-panel { border: 1px solid #dee2e6; border-radius: 4px; background: #fff; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); overflow: hidden; }
    .dash-panel-header { background: #1f66d1; border-bottom: 1px solid #1a56b3; }
    .italic { font-style: italic; }
    .xxs-label { font-size: 0.65rem; color: #6c757d; text-transform: uppercase; font-weight: bold; margin-bottom: 2px; display: block; }
    .btn-xxs { padding: 1px 4px; font-size: 0.7rem; line-height: 1.2; }
    .overdue-box { border: 1px solid #ced4da !important; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        let pieChart, barChart, lineChart;
        let colorMap = {}; 
        let currentPercentages = @Html.Raw(percentagesJson);
        let currentFilter = 'Loan';
        let currentDrillDown = { groupBy: '', groupValue: '', filter: '', overdueOnly: false, fileNumber: null, operatorName: '' };

        const initialLabels = @Html.Raw(labelsJson);
        const initialValues = @Html.Raw(valuesJson);
        const initialTrends = @Html.Raw(trendsJson);

        function getColor(label) {
            if (colorMap[label]) return colorMap[label];
            const r = Math.floor(Math.random() * 200) + 50;
            const g = Math.floor(Math.random() * 200) + 50;
            const b = Math.floor(Math.random() * 200) + 50;
            colorMap[label] = `rgba(${r}, ${g}, ${b}, 0.7)`;
            return colorMap[label];
        }

        function initCharts() {
            const pieColors = initialLabels.map(l => getColor(l));

            const tooltipOptions = {
                callbacks: {
                    label: function(context) {
                        let label = context.label || '';
                        let value = context.raw || 0; 
                        if (currentFilter === 'Loan' && currentPercentages.length > context.dataIndex) {
                            let pct = currentPercentages[context.dataIndex];
                            return `${label}: ${value} (${pct.toFixed(2)}% of library selection)`;
                        }
                        return `${label}: ${value}`;
                    }
                }
            };

            pieChart = new Chart(document.getElementById("pieChart").getContext("2d"), {
                type: 'pie',
                data: {
                    labels: initialLabels.length ? initialLabels : ["No Data"],
                    datasets: [{ data: initialValues.length ? initialValues : [0], backgroundColor: pieColors }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { 
                        legend: { position: 'top', labels: { boxWidth: 10, font: { size: 9 }, padding: 8 } },
                        tooltip: tooltipOptions
                    },
                    onClick: (evt, activeElements) => onChartClick(evt, activeElements, pieChart)
                }
            });

            barChart = new Chart(document.getElementById("barChart").getContext("2d"), {
                type: 'bar',
                data: {
                    labels: initialLabels.length ? initialLabels : ["No Data"],
                    datasets: [{ label: 'Counts', data: initialValues.length ? initialValues : [0], backgroundColor: pieColors }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: tooltipOptions },
                    scales: { 
                        y: { beginAtZero: true, ticks: { precision: 0, font: { size: 9 } } },
                        x: { ticks: { font: { size: 9 } } }
                    },
                    onClick: (evt, activeElements) => onChartClick(evt, activeElements, barChart)
                }
            });

            const lineDatasets = initialTrends.map(t => ({
                label: t.label,
                data: t.counts,
                borderColor: getColor(t.label),
                backgroundColor: 'transparent',
                borderWidth: 2,
                tension: 0.3,
                pointRadius: 2
            }));

            lineChart = new Chart(document.getElementById("lineChart").getContext("2d"), {
                type: 'line',
                data: { labels: initialTrends.length > 0 ? initialTrends[0].dates : [], datasets: lineDatasets },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { 
                        legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 8 }, padding: 5 } } 
                    },
                    scales: { 
                        y: { beginAtZero: true, ticks: { precision: 0, font: { size: 9 } } },
                        x: { ticks: { font: { size: 9 } } }
                    }
                }
            });
        }

        async function updateDashboard() {
            currentFilter = document.getElementById("filterType").value;
            const params = new URLSearchParams({
                filter: currentFilter,
                groupBy: document.getElementById("groupBy").value,
                from: document.getElementById("fromDate").value,
                to: document.getElementById("toDate").value,
                overdueOnly: document.getElementById("overdueOnly").checked,
                fileNumber: document.getElementById("fileNumber").value,
                operatorName: document.getElementById("operatorName").value
            });

            const response = await fetch(`/Dashboard/GetChartData?${params.toString()}`);
            const data = await response.json();

            currentPercentages = data.percentages;

            const pieColors = data.labels.map(l => getColor(l));
            pieChart.data.labels = data.labels;
            pieChart.data.datasets[0].data = data.values;
            pieChart.data.datasets[0].backgroundColor = pieColors;
            pieChart.update();

            barChart.data.labels = data.labels;
            barChart.data.datasets[0].data = data.values;
            barChart.data.datasets[0].backgroundColor = pieColors;
            barChart.update();

            lineChart.data.labels = data.trends.length > 0 ? data.trends[0].dates : [];
            lineChart.data.datasets = data.trends.map(t => ({
                label: t.label,
                data: t.counts,
                borderColor: getColor(t.label),
                backgroundColor: 'transparent',
                borderWidth: 2,
                tension: 0.3,
                pointRadius: 2
            }));
            document.getElementById("trendTitle").textContent = currentFilter === 'Loan' ? 'Loan Activity Trends by Group' : 'User Registration Trends by Group';
            lineChart.update();
        }

        async function onChartClick(evt, activeElements, chartInstance) {
            if (activeElements && activeElements.length > 0) {
                const index = activeElements[0].index;
                const label = chartInstance.data.labels[index];
                currentDrillDown = {
                    groupBy: document.getElementById("groupBy").value,
                    groupValue: label,
                    filter: currentFilter,
                    overdueOnly: document.getElementById("overdueOnly").checked,
                    fileNumber: document.getElementById("fileNumber").value,
                    operatorName: document.getElementById("operatorName").value
                };
                document.getElementById("drillDownTitle").textContent = `Borrower Details: ${label}`;
                await loadDrillDownPage(1);
            }
        }

        async function loadDrillDownPage(page) {
            const container = document.getElementById("drillDownContainer");
            container.style.opacity = "0.5";
            const params = new URLSearchParams({ ...currentDrillDown, page: page });
            const response = await fetch(`/Dashboard/GetDrillDown?${params.toString()}`);
            const html = await response.text();
            container.innerHTML = html;
            container.style.opacity = "1";
            document.getElementById("drillDownActions").classList.remove("d-none");
        }

        document.getElementById("refreshBtn").addEventListener("click", updateDashboard);
        document.getElementById("filterType").addEventListener("change", (e) => {
            const isUser = e.target.value === "User";
            document.getElementById("overdueWrapper").classList.toggle("d-none", isUser);
            document.getElementById("operatorWrapper").classList.toggle("d-none", !isUser);
            
            const groupBy = document.getElementById("groupBy");
            const catSubjectOpt = groupBy.querySelector('option[value="CatalogueSubject"]');
            if (isUser) {
                if (groupBy.value === "CatalogueSubject") groupBy.value = "Class";
                catSubjectOpt.disabled = true;
                catSubjectOpt.classList.add("d-none");
            } else {
                catSubjectOpt.disabled = false;
                catSubjectOpt.classList.remove("d-none");
            }
            updateDashboard();
        });
        document.getElementById("groupBy").addEventListener("change", updateDashboard);

        initCharts();
    </script>
}
