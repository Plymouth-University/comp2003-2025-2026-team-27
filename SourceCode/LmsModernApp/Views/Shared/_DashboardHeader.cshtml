@{
    // For active tab highlighting
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    Func<string, string, string> isActive = (c, a) =>
        (string.Equals(controller, c, StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, a, StringComparison.OrdinalIgnoreCase))
        ? "active" : "";
}

<!-- TOP HEADER -->
<div class="topbar">
    <div class="brand">
        <span class="brand-badge">247</span>
        <span class="brand-name">lib.com</span>
    </div>

    <div class="topbar-right">
        <!-- Text size options and staff logout removed as requested -->
    </div>
</div>


<nav class="nav-tabs-modern">
    <a class="navtab @isActive("Dashboard", "Index")" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
    <a class="navtab @isActive("Authorities", "Index")" asp-controller="Authorities" asp-action="Index">Authorities</a>
    <a class="navtab @isActive("Users", "Index")" asp-controller="Users" asp-action="Index">Users</a>
    <a class="navtab @isActive("Catalogue", "Index")" asp-controller="Catalogue" asp-action="Index">Catalogue</a>
    <a class="navtab @isActive("Circulation", "Index")" asp-controller="Circulation" asp-action="Index">Circulation</a>
    <a class="navtab @isActive("Reports", "Index")" asp-controller="Reports" asp-action="Index">Reports</a>
    <a class="navtab @isActive("StockItems", "Index")" asp-controller="StockItems" asp-action="Index">Stock Items</a>
</nav>

<hr class="thin-rule" />

<style>
    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .brand-badge {
        background: #2b78ff;
        color: #fff;
        font-weight: 700;
        padding: 6px 10px;
        border-radius: 4px;
        line-height: 1;
    }

    .brand-name {
        font-weight: 700;
        font-size: 20px;
        color: #d11b2d;
    }

    .topbar-right {
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .thin-rule {
        margin: 6px 0 10px;
    }

    .nav-tabs-modern {
        display: flex;
        gap: 10px;
        padding: 0 12px 8px;
        flex-wrap: wrap;
    }

    .navtab {
        background: #1f66d1;
        color: #fff;
        text-decoration: none;
        padding: 6px 14px;
        border-radius: 3px;
        font-weight: 600;
        border: 1px solid #0f56c0;
        transition: transform .05s ease, filter .15s ease;
    }

    .navtab:hover {
        filter: brightness(1.1);
    }

    .navtab:active {
        transform: translateY(1px);
    }

    .navtab.active {
        background: #0f56c0;
        box-shadow: inset 0 0 0 2px rgba(255,255,255,.25);
    }
</style>
