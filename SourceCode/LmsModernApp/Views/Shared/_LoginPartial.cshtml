<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
    var locationName = User.FindFirst("WorkingLocationName")?.Value;
    
    <li class="nav-item">
        <span class="nav-link text-dark">Hello @User.Identity.Name!</span>
    </li>
    
    @if (!string.IsNullOrEmpty(locationName))
    {
        <li class="nav-item">
            <span class="nav-link text-muted fw-bold">| @locationName</span>
        </li>
        <li class="nav-item">
            <a class="nav-link text-primary" asp-controller="Account" asp-action="SelectLocation" title="Change Location">
                <i class="bi bi-geo-alt-fill"></i> Change
            </a>
        </li>
    }

    <li class="nav-item">
        <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
        </form>
    </li>
}
</ul>
