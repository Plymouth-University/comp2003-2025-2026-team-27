@model LmsModernApp.Models.BorrowerExtendedViewModel
@{
    ViewData["Title"] = "Borrower Surveys";
}

<partial name="_DashboardHeader" />

<div class="row mt-3">
    <partial name="_UsersSidebar" />

    <div class="col-md-10 text-center py-5">
        <div class="mb-4">
            <i class="bi bi-clipboard-x text-muted" style="font-size: 5rem;"></i>
        </div>
        <h3 class="text-secondary">Borrower Surveys</h3>
        <p class="text-muted mb-4">There are currently no active surveys assigned to this borrower.</p>
        <a asp-action="@(ViewBag.Origin ?? "UsersMoreOptions")" class="btn btn-outline-primary shadow-sm px-4">
            <i class="bi bi-arrow-left me-2"></i> Return
        </a>
    </div>
</div>
