@model LmsModernApp.Models.BorrowerMaintenanceViewModel
@{
    ViewData["Title"] = "Users - Extended Options";
}

<style>
    /* Legacy-inspired styling for the action lists */
    .action-category {
        margin-bottom: 1.5rem;
    }
    .action-category h5 {
        background-color: #f0f0f0;
        padding: 8px 12px;
        border-bottom: 2px solid #0d6efd;
        font-size: 1rem;
        font-weight: 700;
        color: #333;
    }
    .action-list {
        list-style: none;
        padding-left: 0;
    }
    .action-list li {
        padding: 6px 12px;
        border-bottom: 1px solid #eee;
    }
    .action-list li:last-child {
        border-bottom: none;
    }
    .action-link {
        text-decoration: none;
        color: #0d6efd;
        font-weight: 600;
        font-size: 0.9rem;
        background: none;
        border: none;
        padding: 0;
    }
    .action-link:hover {
        text-decoration: underline;
    }
    .action-desc {
        font-size: 0.75rem;
        color: #666;
        display: block;
    }
    
    /* Header Summary Styling */
    .profile-summary {
        background-color: #f8f9fa;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 15px;
        margin-bottom: 20px;
    }
    .summary-col {
        border-right: 1px solid #eee;
    }
    .summary-col:last-child {
        border-right: none;
    }
    .summary-item {
        font-size: 0.85rem;
        margin-bottom: 6px;
        display: flex;
        justify-content: space-between;
    }
    .summary-label {
        font-weight: 600;
        color: #555;
    }
    .summary-value {
        font-weight: 700;
        color: #000;
        text-align: right;
    }
    .profile-photo-placeholder {
        width: 100px;
        height: 120px;
        border: 1px solid #ccc;
        background-color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }
</style>

<partial name="_DashboardHeader" />

<div class="row mt-3">
    <partial name="_UsersSidebar" />

    <div class="col-md-10">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Return Navigation (Above Borrower Info) -->
        <div class="mb-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="location.href='@Url.Action("Index", new { id = Model.Borrower.BorNo })'">
                <i class="bi bi-arrow-left"></i> Return to Main Record
            </button>
        </div>

        <!-- Profile Header Summary -->
        <div class="profile-summary shadow-sm">
            <div class="row g-0">
                <!-- Column 1: Borrower, Type, Status, Location -->
                <div class="col-md-3 px-3 summary-col">
                    <div class="summary-item">
                        <span class="summary-label">Borrower:</span>
                        <span class="summary-value">@Model.Borrower.BorBarNo</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Type:</span>
                        <span class="summary-value">@Model.Borrower.BorType</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Status:</span>
                        <span class="summary-value">@Model.Borrower.BorStatus</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Location:</span>
                        <span class="summary-value">@Model.Borrower.BorLocation</span>
                    </div>
                </div>

                <!-- Column 2: Name, Loans -->
                <div class="col-md-3 px-3 summary-col">
                    <div class="summary-item">
                        <span class="summary-label">Name:</span>
                        <span class="summary-value text-primary">@Model.Borrower.BorGiven @Model.Borrower.BorSurname</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Loans:</span>
                        <span class="summary-value">@(Model.Borrower.BorNoLoans ?? 0)</span>
                    </div>
                </div>

                <!-- Column 3: Reservations, Memos, Balance -->
                <div class="col-md-3 px-3 summary-col">
                    <div class="summary-item">
                        <span class="summary-label">Reservations:</span>
                        <span class="summary-value">@(Model.Borrower.BorNoReserves ?? 0)</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Memos:</span>
                        <span class="summary-value">0</span>
                    </div>
                    <div class="summary-item mt-2 pt-2 border-top">
                        <span class="summary-label">Balance:</span>
                        <span class="summary-value text-danger">@(Model.Borrower.BorOwing?.ToString("C") ?? "£0.00")</span>
                    </div>
                </div>

                <!-- Column 4: Image Placeholder -->
                <div class="col-md-3 text-center d-flex align-items-center justify-content-center">
                    <div class="profile-photo-placeholder shadow-sm">
                        @if (Model.Borrower.BorNo > 0)
                        {
                            <img src="@Url.Action("GetPicture", "Users", new { borNo = Model.Borrower.BorNo })" 
                                 alt="Profile Photo" 
                                 style="max-width: 100%; max-height: 100%; display: block;" 
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                            <i class="bi bi-person text-muted" style="font-size: 3.5rem; display: none;"></i>
                        }
                        else
                        {
                            <i class="bi bi-person text-muted" style="font-size: 3.5rem;"></i>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Lists Columned -->
        <div class="row">
            <!-- Left Column -->
            <div class="col-md-6">
                <div class="action-category">
                    <h5><i class="bi bi-person-lines-fill me-2"></i>Borrower Actions</h5>
                    <ul class="action-list">
                        <li>
                            <a href="#" class="action-link" data-bs-toggle="modal" data-bs-target="#uploadPictureModal">Picture Upload</a>
                            <span class="action-desc">Upload or change the borrower's profile photo.</span>
                        </li>
                        <li>
                            <a asp-action="ILR" class="action-link">ILR (Individual Learning Record)</a>
                            <span class="action-desc">View and manage learning progress and records.</span>
                        </li>
                        <li>
                            <a href="#" class="action-link" data-bs-toggle="modal" data-bs-target="#biometricsModal">Biometrics</a>
                            <span class="action-desc">Configure fingerprint or iris recognition settings.</span>
                        </li>
                        <li>
                            <a href="#" class="action-link" data-bs-toggle="modal" data-bs-target="#reRegistrationModal">Re-registration (Expiry)</a>
                            <span class="action-desc">Update membership expiration and renewal dates.</span>
                        </li>
                        <li>
                            <a href="#" class="action-link" data-bs-toggle="modal" data-bs-target="#amendJoinedDateModal">Joining Date Amendment</a>
                            <span class="action-desc">Modify the historical membership start date.</span>
                        </li>
                        <li>
                            <a asp-action="Surveys" class="action-link">Surveys</a>
                            <span class="action-desc">View completed surveys or assign new ones.</span>
                        </li>
                        <li>
                            <a asp-action="FinancialTransactions" class="action-link">Financial Transactions</a>
                            <span class="action-desc">Manage payments, fines, and historical charges.</span>
                        </li>
                        <li>
                            <a asp-action="History" class="action-link">History</a>
                            <span class="action-desc">Exhaustive audit trail of all account activities.</span>
                        </li>
                        <li>
                            <a asp-action="Memos" class="action-link">Memos</a>
                            <span class="action-desc">Internal notes and system alerts for this user.</span>
                        </li>
                        <li>
                            <a asp-action="Addresses" asp-route-borNo="@Model.Borrower.BorNo" class="action-link">Addresses</a>
                            <span class="action-desc">Manage multiple residential and correspondence contacts.</span>
                        </li>
                        <li>
                            <a asp-action="Courses" class="action-link">Groups, Classes & Courses</a>
                            <span class="action-desc">Update academic and organizational affiliations.</span>
                        </li>
                        <li>
                            <a asp-action="SendEmail" asp-route-borNo="@Model.Borrower.BorNo" class="action-link">Email</a>
                            <span class="action-desc">Send direct communications or manage subscriptions.</span>
                        </li>
                    </ul>
                </div>

                <div class="action-category">
                    <h5><i class="bi bi-link-45deg me-2"></i>Cross Reference</h5>
                    <ul class="action-list">
                        <li>
                            <a asp-controller="Circulation" asp-action="Index" asp-route-barcode="@Model.Borrower.BorBarNo" class="action-link">Circulation Module</a>
                            <span class="action-desc">Switch to the circulation desk for loans and returns.</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-md-6">
                <div class="action-category">
                    <h5><i class="bi bi-shield-lock me-2"></i>OPAC & Security</h5>
                    <ul class="action-list">
                        <li>
                            <form asp-action="ApproveBorrower" asp-route-id="@Model.Borrower.BorNo" onsubmit="return confirm('Approve this borrower registration?')">
                                <button type="submit" class="action-link text-success">Approve Registration</button>
                            </form>
                            <span class="action-desc">Authorize web portal access for this account.</span>
                        </li>
                        <li>
                            <form asp-action="RejectBorrower" asp-route-id="@Model.Borrower.BorNo" onsubmit="return confirm('Reject this borrower registration?')">
                                <button type="submit" class="action-link text-danger">Reject Registration</button>
                            </form>
                            <span class="action-desc">Decline or suspend web portal access.</span>
                        </li>
                        <li>
                            <form asp-action="ResetBorrowerPin" asp-route-barcode="@Model.Borrower.BorBarNo" onsubmit="return confirm('Reset PIN and force change on next login?')">
                                <button type="submit" class="action-link">Pin Reset</button>
                            </form>
                            <span class="action-desc">Generate a new security pin for OPAC login.</span>
                        </li>
                    </ul>
                </div>

                <div class="action-category">
                    <h5><i class="bi bi-folder2-open me-2"></i>File Management</h5>
                    <ul class="action-list">
                        <li>
                            <a asp-action="SelectFileForBorrower" asp-route-isRemove="false" class="action-link">Add to Virtual File</a>
                            <span class="action-desc">Place this borrower into a selection for batch processing.</span>
                        </li>
                        <li>
                            <a asp-action="SelectFileForBorrower" asp-route-isRemove="true" class="action-link">Remove from Virtual File</a>
                            <span class="action-desc">Remove this borrower from their current batch assignments.</span>
                        </li>
                    </ul>
                </div>

                <div class="action-category">
                    <h5><i class="bi bi-people me-2"></i>Family & Group Relationships</h5>
                    <ul class="action-list">
                        <li>
                            <form asp-action="SetAsParent" asp-route-id="@Model.Borrower.BorNo" onsubmit="return confirm('Set this borrower as a Parent for future linking?')">
                                <button type="submit" class="action-link">Set as Parent</button>
                            </form>
                            <span class="action-desc">Enable this account to have dependents linked to it.</span>
                        </li>
                        <li>
                            <a asp-action="ViewRelatedMembers" asp-route-id="@Model.Borrower.BorNo" class="action-link">View Related Members</a>
                            <span class="action-desc">See all dependents or linked group members.</span>
                        </li>
                        <li>
                            <form asp-action="BreakRelationship" asp-route-id="@Model.Borrower.BorNo" onsubmit="return confirm('Break all relationship links for this borrower?')">
                                <button type="submit" class="action-link text-warning">Break Link</button>
                            </form>
                            <span class="action-desc">Dissolve the current relationship association.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Upload Picture Modal -->
<div class="modal fade" id="uploadPictureModal" tabindex="-1" aria-labelledby="uploadPictureModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="uploadPictureModalLabel">Upload Borrower Picture</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UploadPicture" method="post" enctype="multipart/form-data">
                <input type="hidden" name="borNo" value="@Model.Borrower.BorNo" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="file" class="form-label">Select Image File</label>
                        <input type="file" class="form-control" id="file" name="file" accept="image/*" required>
                        <div class="form-text">Supported formats: JPG, PNG, GIF. Max size: 2MB.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </form>
            @if (Model.Borrower.BorNo > 0)
            {
                <div class="modal-footer justify-content-start border-top-0 pt-0">
                    <form asp-action="RemovePicture" method="post" onsubmit="return confirm('Are you sure you want to remove the current picture?')">
                        <input type="hidden" name="borNo" value="@Model.Borrower.BorNo" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Remove Current Picture</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<!-- Re-registration Modal -->
<div class="modal fade" id="reRegistrationModal" tabindex="-1" aria-labelledby="reRegistrationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reRegistrationModalLabel">Re-register Borrower</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ReRegistration" method="post">
                <input type="hidden" name="borNo" value="@Model.Borrower.BorNo" />
                <div class="modal-body">
                    <p>Current Expiry Date: <strong>@(Model.Borrower.BorRegdate?.ToString("D") ?? "--/--/--")</strong></p>
                    <div class="mb-3">
                        <label for="newExpiryDate" class="form-label">New Expiry Date</label>
                        <input type="date" class="form-control" id="newExpiryDate" name="newExpiryDate" value="@DateTime.Now.AddMonths(12).ToString("yyyy-MM-dd")" required>
                        <div class="form-text">Defaults to 12 months from today.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Registration</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Amend Joined Date Modal -->
<div class="modal fade" id="amendJoinedDateModal" tabindex="-1" aria-labelledby="amendJoinedDateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="amendJoinedDateModalLabel">Amend Joining Date</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AmendJoiningDate" method="post">
                <input type="hidden" name="borNo" value="@Model.Borrower.BorNo" />
                <div class="modal-body">
                    <p>Current Joining Date: <strong>@(Model.Borrower.BorStartMship?.ToString("D") ?? "--/--/--")</strong></p>
                    <div class="mb-3">
                        <label for="newJoiningDate" class="form-label">New Joining Date</label>
                        <input type="date" class="form-control" id="newJoiningDate" name="newJoiningDate" value="@(Model.Borrower.BorStartMship?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Date</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Placeholder Modals for not-yet-implemented complex features -->
<div class="modal fade" id="biometricsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Biometrics</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Biometric configuration interface is not available.</div></div></div>
</div>
