@model LmsModernApp.ViewModels.CatalogueViewModel
@{
    ViewData["Title"] = "Catalogue";
    Layout = "_Layout";
}

<partial name="_DashboardHeader" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap');

    :root {
        --primary: #1f66d1;
        --primary-light: #2b78ff;
        --accent: #d11b2d;
        --surface: #f8f9fc;
        --sidebar-bg: #f1f4fb;
        --border: #dde3f0;
        --text-main: #1e2a45;
        --text-muted: #6b7a99;
        --table-header: #1f66d1;
        --action-hover: #e8edf8;
        --radius: 6px;
        --shadow-sm: 0 1px 3px rgba(26,79,186,.10);
        --shadow-md: 0 4px 16px rgba(26,79,186,.12);
    }

    .catalogue-wrap, .catalogue-wrap * {
        font-family: 'DM Sans', sans-serif;
        box-sizing: border-box;
    }

    .catalogue-wrap {
        display: flex;
        min-height: calc(100vh - 120px);
        background: var(--surface);
        margin: 0 -12px;
    }

    /* ── Sidebar ── */
    .cat-sidebar {
        width: 210px;
        min-width: 210px;
        background: var(--sidebar-bg);
        border-right: 1px solid var(--border);
        padding: 16px 0 30px;
    }

    .sidebar-section-title {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 0 18px 6px;
        margin-top: 14px;
    }

    .cat-sidebar a {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 18px;
        font-size: 13px;
        color: var(--text-main);
        text-decoration: none;
        border-left: 3px solid transparent;
        transition: background .15s, border-color .15s, color .15s;
    }

        .cat-sidebar a:hover {
            background: var(--action-hover);
            border-left-color: var(--primary-light);
            color: var(--primary);
        }

    .cat-sidebar .dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--border);
        flex-shrink: 0;
    }

    .sidebar-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 10px 18px;
    }

    /* ── Main ── */
    .cat-main {
        flex: 1;
        padding: 20px 24px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        overflow: hidden;
    }

    .module-title {
        font-size: 17px;
        font-weight: 600;
        color: var(--text-main);
    }

    /* ── Toolbar ── */
    .cat-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        padding: 8px 12px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
    }

    .tb-divider {
        width: 1px;
        background: var(--border);
        margin: 2px 3px;
        align-self: stretch;
    }

    .tb-btn {
        display: inline-flex;
        align-items: center;
        padding: 4px 9px;
        font-size: 12px;
        font-weight: 500;
        color: var(--primary);
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 4px;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
        transition: background .13s, color .13s, border-color .13s;
    }

        .tb-btn:hover {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

        .tb-btn.tb-danger {
            color: var(--accent);
            border-color: #f5c6cb;
        }

            .tb-btn.tb-danger:hover {
                background: var(--accent);
                color: #fff;
                border-color: var(--accent);
            }

    /* ── Search panel ── */
    .search-panel {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 14px 16px 10px;
        box-shadow: var(--shadow-sm);
    }

    .search-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 10px;
    }

    .search-field {
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .search-field label {
            font-size: 12px;
            font-weight: 500;
            color: var(--text-muted);
            white-space: nowrap;
        }

        .search-field input,
        .search-field select {
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            padding: 5px 9px;
            border: 1px solid var(--border);
            border-radius: 4px;
            background: var(--surface);
            color: var(--text-main);
            outline: none;
            transition: border-color .15s, box-shadow .15s;
        }

            .search-field input:focus,
            .search-field select:focus {
                border-color: var(--primary-light);
                box-shadow: 0 0 0 3px rgba(43,120,255,.12);
            }

            .search-field input[type="text"] {
                width: 190px;
            }

    .search-btn {
        padding: 5px 16px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: #fff;
        background: var(--primary);
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: background .13s;
    }

        .search-btn:hover {
            background: var(--primary-light);
        }

    .meta-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .meta-field {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .meta-field label {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 500;
            white-space: nowrap;
        }

        .meta-field input {
            font-family: 'DM Sans', sans-serif;
            font-size: 12px;
            padding: 3px 7px;
            border: 1px solid var(--border);
            border-radius: 4px;
            background: var(--surface);
            width: 90px;
            outline: none;
        }

    /* ── Search feedback ── */
    .search-feedback {
        font-size: 13px;
        color: var(--text-muted);
        padding: 4px 0;
    }

        .search-feedback.no-results {
            color: var(--accent);
        }

        .search-feedback.has-results {
            color: #16a34a;
            font-weight: 500;
        }

    /* ── Content area ── */
    .content-area {
        display: flex;
        gap: 12px;
        flex: 1;
    }

    .table-wrap {
        flex: 1;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .cat-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .cat-table thead tr {
            background: var(--table-header);
        }

        .cat-table thead th {
            padding: 9px 13px;
            text-align: left;
            font-size: 11px;
            font-weight: 600;
            color: #fff;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .cat-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .cat-table tbody tr:hover {
                background: var(--action-hover);
            }

        .cat-table tbody td {
            padding: 9px 13px;
            font-size: 13px;
            color: var(--text-main);
        }

        .cat-table .empty-row td {
            color: var(--text-muted);
            font-style: italic;
            text-align: center;
            padding: 40px 0;
        }

    /* ── Right action panel ── */
    .action-panel {
        width: 108px;
        min-width: 108px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .act-btn {
        display: block;
        width: 100%;
        padding: 7px 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 12px;
        font-weight: 500;
        text-align: center;
        color: var(--primary);
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        text-decoration: none;
        cursor: pointer;
        box-shadow: var(--shadow-sm);
        transition: background .13s, color .13s, border-color .13s, box-shadow .13s;
    }

        .act-btn:hover {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
            box-shadow: var(--shadow-md);
        }

        .act-btn.act-danger {
            color: var(--accent);
            border-color: #f5c6cb;
        }

            .act-btn.act-danger:hover {
                background: var(--accent);
                color: #fff;
                border-color: var(--accent);
            }

    .act-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2px 0;
    }

    .tb-btn:disabled {
        opacity: .4;
        cursor: not-allowed;
        pointer-events: none;
    }

    .act-btn:disabled {
        opacity: .4;
        cursor: not-allowed;
        pointer-events: none;
    }

    .cat-table tbody tr.row-selected {
        background: #dbeafe !important;
        outline: 2px solid var(--primary);
        outline-offset: -2px;
    }
</style>

<script>
    function goPage(page) {
        document.getElementById('page-input').value = page;
        document.getElementById('search-form').submit();
    }

    var selectedCatNo = null;

    function selectRow(row) {
        if (row.classList.contains('row-selected')) {
            // Second click on the already-focused row — open Details
            window.location.href = row.dataset.detailsUrl;
            return;
        }
        document.querySelectorAll('.result-row').forEach(r => r.classList.remove('row-selected'));
        row.classList.add('row-selected');
        selectedCatNo = row.dataset.catno;
        document.getElementById('btn-modify').disabled = false;
        document.getElementById('btn-delete').disabled = false;
    }

    function getSearchReturnUrl() {
        var searchText   = document.querySelector('[name="SearchText"]').value;
        var searchMethod = document.querySelector('[name="SearchMethod"]').value;
        var libGroup     = document.querySelector('[name="LibGroup"]').value;
        var page         = document.getElementById('page-input').value;
        return '/Catalogue/Search?SearchText=' + encodeURIComponent(searchText)
             + '&SearchMethod='                + encodeURIComponent(searchMethod)
             + '&LibGroup='                    + encodeURIComponent(libGroup)
             + '&Page='                        + encodeURIComponent(page);
    }

    function goModify() {
        if (selectedCatNo)
            window.location.href = '/Catalogue/Modify?catNo=' + encodeURIComponent(selectedCatNo)
                                 + '&returnUrl=' + encodeURIComponent(getSearchReturnUrl());
    }

    function goDelete() {
        if (selectedCatNo)
            window.location.href = '/Catalogue/Delete?catNo=' + encodeURIComponent(selectedCatNo);
    }
</script>

<div class="catalogue-wrap">

    <!-- ── Sidebar ── -->
    <aside class="cat-sidebar">
        <div class="sidebar-section-title">Templates</div>
        <a asp-controller="Catalogue" asp-action="Book"><span class="dot"></span> Book</a>
        <a asp-controller="Catalogue" asp-action="News"><span class="dot"></span> News</a>
        <a asp-controller="Catalogue" asp-action="Event"><span class="dot"></span> Event</a>
        <a asp-controller="Catalogue" asp-action="UploadFile"><span class="dot"></span> Upload File</a>
        <a asp-controller="Catalogue" asp-action="WebSiteUrl"><span class="dot"></span> Web Site – URL</a>
        <a asp-controller="Catalogue" asp-action="Discussion"><span class="dot"></span> Discussion</a>
        <a asp-controller="Catalogue" asp-action="CatalogueTemplate"><span class="dot"></span> Catalogue Template</a>
        <a asp-controller="Catalogue" asp-action="AmendWebsite"><span class="dot"></span> Amend Website</a>
        <hr class="sidebar-divider" />
        <a asp-controller="Catalogue" asp-action="Z3950Search">Z39.50 Search</a>
        <a asp-controller="Catalogue" asp-action="NielsenImport">Nielsen Import</a>
        <a asp-controller="Catalogue" asp-action="MassMaintenance">Mass Maintenance</a>
        <a asp-controller="Catalogue" asp-action="UploadCatalogueFiles">Upload Catalogue Files</a>
        <a asp-controller="Catalogue" asp-action="Archive">Archive</a>
    </aside>

    <!-- ── Main ── -->
    <main class="cat-main">

        <div class="module-title">Catalogue Module</div>

        <!-- Toolbar -->
        <div class="cat-toolbar">
            <a asp-controller="Catalogue" asp-action="Index" class="tb-btn">Clear</a>
            <a asp-controller="Catalogue" asp-action="Duplicate" class="tb-btn">Duplicate</a>
            <a asp-controller="Catalogue" asp-action="Update" class="tb-btn">Update</a>
            <a asp-controller="Catalogue" asp-action="Delete" class="tb-btn tb-danger">Delete</a>
            <div class="tb-divider"></div>
            <a asp-controller="Catalogue" asp-action="UploadPictures" class="tb-btn">Upload Pictures</a>
            <a asp-controller="Catalogue" asp-action="RemovePicture" class="tb-btn">Remove Picture</a>
            <div class="tb-divider"></div>
            <a asp-controller="Catalogue" asp-action="TableView" class="tb-btn">Table View</a>
            <a asp-controller="Catalogue" asp-action="MarcView" class="tb-btn">MARC View</a>
            <a asp-controller="Catalogue" asp-action="Export" class="tb-btn">Export</a>
            <div class="tb-divider"></div>
            <button type="button" class="tb-btn" id="btn-first" onclick="goPage(0)" @(Model.Page == 0 ? "disabled" : "")>&#10218;&#10218; First</button>
            <button type="button" class="tb-btn" id="btn-prev" onclick="goPage(@(Model.Page - 1))" @(Model.Page == 0 ? "disabled" : "")>&#10218; Prev</button>
            <button type="button" class="tb-btn" id="btn-next" onclick="goPage(@(Model.Page + 1))" @(Model.Page >= Model.TotalPages - 1 ? "disabled" : "")>Next &#10219;</button>
            <button type="button" class="tb-btn" id="btn-last" onclick="goPage(@(Model.TotalPages - 1))" @(Model.Page >= Model.TotalPages - 1 ? "disabled" : "")>Last &#10219;&#10219;</button>
            <a asp-controller="Catalogue" asp-action="More" class="tb-btn">More</a>
        </div>

        <!-- Search panel -->
        <form asp-controller="Catalogue" asp-action="Search" method="post" id="search-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Page" id="page-input" value="@Model.Page" />
            <div class="search-panel">
                <div class="search-row">
                    <div class="search-field">
                        <label>Search Text</label>
                        <input type="text" name="SearchText" value="@Model.SearchText" placeholder="Enter search…" />
                    </div>
                    <div class="search-field">
                        <label>Search Method</label>
                        <select name="SearchMethod">
                            @foreach (var method in Model.SearchMethods)
                            {
                                <option value="@method" selected="@(Model.SearchMethod == method)">@method</option>
                            }
                        </select>
                    </div>
                    <div class="search-field">
                        <label>Lib Group</label>
                        <select name="LibGroup">
                            @foreach (var group in Model.LibGroups)
                            {
                                <option value="@group" selected="@(Model.LibGroup == group)">@group</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="search-btn">Search</button>
                </div>
                <div class="meta-row">
                    <div class="meta-field">
                        <label>OPAC View Restriction</label>
                        <input type="text" name="OpacViewRestriction" value="@Model.OpacViewRestriction" />
                    </div>
                    <div class="meta-field">
                        <label>Security</label>
                        <input type="text" name="Security" value="@Model.Security" style="width:50px;" />
                    </div>
                    <div class="meta-field">
                        <label>Library Group</label>
                        <input type="text" name="LibraryGroup" value="@Model.LibraryGroup" />
                    </div>
                    <div class="meta-field">
                        <label>Template Id</label>
                        <input type="text" name="TemplateId" value="@Model.TemplateId" style="width:70px;" />
                    </div>
                </div>
            </div>

            <!-- Search feedback -->
            @if (!string.IsNullOrEmpty(Model.SearchText))
            {
                if (Model.TotalCount > 0)
                {
                    var from = Model.Page * 20 + 1;
                    var to = Math.Min(from + 20 - 1, Model.TotalCount);
                    <div class="search-feedback has-results">
                        Showing @from–@to of @Model.TotalCount result(s) for "@Model.SearchText"
                        @if (Model.TotalPages > 1)
                        {
                            <span style="color:var(--text-muted);font-weight:400"> — page @(Model.Page + 1) of @Model.TotalPages</span>
                        }
                    </div>
                }
                else
                {
                    <div class="search-feedback no-results">No results found for "@Model.SearchText"</div>
                }
            }

        </form>

        <!-- Table + right actions -->
        <div class="content-area">
            <div class="table-wrap">
                <table class="cat-table">
                    <thead>
                        <tr>
                            <th style="width:100px;">Ref No</th>
                            <th style="width:40%;">Title</th>
                            <th>Author</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr class="result-row"
                                    data-catno="@item.Tag"
                                    data-details-url="@Url.Action("Details", "Catalogue", new { catNo = item.Tag, libGroup = Model.LibGroup })"
                                    onclick="selectRow(this)"
                                    style="cursor:pointer;">
                                    <td>@item.Tag</td>
                                    <td>@item.TagDescription</td>
                                    <td>@item.TagDetails</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="empty-row">
                                <td colspan="3">No catalogue records found. Use the search above to find records.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Right action panel -->
            <div class="action-panel">
                <a asp-controller="Catalogue" asp-action="Add" class="act-btn">Add</a>
                <a asp-controller="Catalogue" asp-action="Insert" class="act-btn">Insert</a>
                <a asp-controller="Catalogue" asp-action="Replace" class="act-btn">Replace</a>
                <button type="button" class="act-btn" id="btn-modify" onclick="goModify()" disabled>Modify</button>
                <hr class="act-divider" />
                <button type="button" class="act-btn act-danger" id="btn-delete" onclick="goDelete()" disabled>Delete</button>
                <a asp-controller="Catalogue" asp-action="Query" class="act-btn">Query</a>
            </div>
        </div>

    </main>
</div>
