@{
    ViewData["Title"] = "Home";
}

<partial name="_DashboardHeader" />

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4 font-weight-bold">Welcome to the 247lib.com Library Management System</h1>
    </div>

    <div class="text-start">
        <h3 class="mb-4">The 247lib.com support desk is open during UK hours of: 9:00 - 17:30 everyday of the week</h3>
        
        <h4 class="mb-3">The 247lib.com includes:</h4>
        <ul class="list-unstyled ms-3">
            <li class="mb-2">✔ <strong>Authorities</strong> - dictionary of reusable catalogue tags</li>
            <li class="mb-2">✔ <strong>Borrowers</strong> - user details, personal preferences, alerts and memos</li>
            <li class="mb-2">✔ <strong>Catalogue</strong> - the catalogue of items, products, services, news, events, discussions ...</li>
            <li class="mb-2">✔ <strong>Circulation</strong> - management of issues, reservations, bookings and renewals</li>
            <li class="mb-2">✔ <strong>Enquiries</strong> - management of patron enquiries</li>
            <li class="mb-2">✔ <strong>Finance</strong> - budgets and accounts (not enabled)</li>
            <li class="mb-2">✔ <strong>ILL Service</strong> - Interlibrary loan transactions and management</li>
            <li class="mb-2">✔ <strong>Orders</strong> - management and maintenance of orders</li>
            <li class="mb-2">✔ <strong>Periodicals</strong> - serials, issues, subscriptions and circulation lists</li>
            <li class="mb-2">✔ <strong>Reports</strong> - for ad hoc and scheduled reports including emails, saved files and SMS messages</li>
            <li class="mb-2">✔ <strong>Stock Items</strong> - details of each catalogue copy such as location</li>
        </ul>

        <div class="mt-5 border-top pt-4">
            <p class="mb-1">For further information please contact:</p>
            <p class="mb-1">Applied Network Solutions Limited, Unit 8, Prisma Park, Berrington Way, Basingstoke, Hampshire, RG24 8GT</p>
            <p class="mb-1">Tel no. 01256 300790</p>
            <p class="mb-1">Web Address <a href="http://www.247lib.com" target="_blank">www.247lib.com</a></p>
            <p class="mt-3">The version of the software is: 1.0.0.0</p>
        </div>
    </div>
</div>
