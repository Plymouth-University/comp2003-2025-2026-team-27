@model LmsModernApp.Models.BorrowerFileListViewModel
@{
    ViewData["Title"] = "Borrower File List";
}

<style>
    .toolbar-btn { min-width: 90px; font-size: 0.85rem; }
    .file-table th, .reading-table th { font-size: 0.85rem; background-color: #f8f9fa; }
    .file-table td, .reading-table td { font-size: 0.85rem; vertical-align: middle; }
    .selected-row { background-color: #e7f1ff !important; border: 2px solid #0d6efd !important; }
    .reading-row { cursor: pointer; transition: background-color 0.2s; }
    .reading-row:hover { background-color: #f1f8ff; }
    .sortable-header { cursor: pointer; transition: background-color 0.2s; }
    .sortable-header:hover { background-color: #e9ecef; }
</style>

<partial name="_DashboardHeader" />

<div class="row mt-3">
    <partial name="_UsersSidebar" />

    <div class="col-md-10">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h4 class="text-primary mb-0">Borrower File List</h4>
            @if (Model.SelectedFileSet.FileNumber > 0)
            {
                <div class="text-muted small">Selected File: <strong>@Model.SelectedFileSet.FileDesc</strong> (ID: @Model.SelectedFileSet.FileNumber)</div>
            }
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Action Toolbar -->
        <div class="d-flex flex-wrap mb-3 border p-1 bg-light rounded shadow-sm align-items-center" role="toolbar">
            <form asp-action="EmptyFileSet" method="post" class="me-1">
                <input type="hidden" name="fileNumber" value="@Model.SelectedFileSet.FileNumber" />
                <button type="submit" class="btn btn-outline-secondary toolbar-btn" @(Model.SelectedFileSet.FileNumber == 0 || !Model.CanEdit ? "disabled" : "")><i class="bi bi-eraser"></i> Empty</button>
            </form>
            
            <button type="button" class="btn btn-primary toolbar-btn me-1" onclick="document.getElementById('editForm').submit()" @(!Model.CanEdit && Model.SelectedFileSet.FileNumber > 0 ? "disabled" : "")><i class="bi bi-save"></i> Save</button>
            
            <button type="button" class="btn btn-outline-secondary toolbar-btn me-1" onclick="location.href='@Url.Action("ClearFileSet")'"><i class="bi bi-file-earmark-plus"></i> Clear/New</button>
            
            <form asp-action="DeleteFileSet" method="post" class="me-1">
                <input type="hidden" name="fileNumber" value="@Model.SelectedFileSet.FileNumber" />
                <button type="submit" class="btn btn-outline-danger toolbar-btn" @(Model.SelectedFileSet.FileNumber == 0 || !Model.CanDelete ? "disabled" : "")><i class="bi bi-trash"></i> Delete</button>
            </form>

            <button type="button" class="btn btn-outline-success toolbar-btn me-1" onclick="document.getElementById('readingListForm').submit()" @(Model.SelectedFileSet.FileNumber == 0 || !Model.CanEdit ? "disabled" : "")><i class="bi bi-book"></i> General Reading List</button>
            
            <button type="button" class="btn btn-outline-info toolbar-btn" @(Model.SelectedFileSet.FileNumber == 0 ? "disabled" : "")><i class="bi bi-envelope"></i> Email</button>
        </div>

        <!-- Filter & Search Row -->
        <div class="row mb-3 align-items-center">
            <div class="col-md-5">
                <div class="d-flex align-items-center">
                    <label class="fw-bold small me-2 text-nowrap">View files by:</label>
                    <select id="creatorFilter" class="form-select form-select-sm" onchange="filterByCreator(this.value)">
                        @foreach (var op in Model.Operators)
                        {
                            <option value="@op.Code" selected='@(Model.SelectedOperator == op.Code)'>@op.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-4 ms-auto">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" id="fileSearch" class="form-control" placeholder="Search file name..." 
                           value="@Model.SearchTerm" onkeypress="if(event.key==='Enter') applySearch(this.value)" />
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <button class="btn btn-outline-secondary" type="button" onclick="applySearch('')"><i class="bi bi-x-lg"></i></button>
                    }
                </div>
            </div>
        </div>

        <!-- Pagination Navigation (Above Table) -->
        <div class="d-flex align-items-center mb-2 bg-light border p-2 rounded shadow-sm">
            <div class="btn-group btn-group-sm me-3">
                <a asp-action="FileList" asp-route-creator="@Model.SelectedOperator" asp-route-page="1" 
                   asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder" asp-route-searchTerm="@Model.SearchTerm"
                   class="btn btn-outline-secondary @(Model.CurrentPage <= 1 ? "disabled" : "")">First</a>
                <a asp-action="FileList" asp-route-creator="@Model.SelectedOperator" asp-route-page="@(Model.CurrentPage - 1)" 
                   asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder" asp-route-searchTerm="@Model.SearchTerm"
                   class="btn btn-outline-secondary @(Model.CurrentPage <= 1 ? "disabled" : "")">Back</a>
            </div>
            
            <span class="small fw-bold text-muted me-3">Page @Model.CurrentPage of @Model.TotalPages</span>

            <div class="btn-group btn-group-sm me-auto">
                <a asp-action="FileList" asp-route-creator="@Model.SelectedOperator" asp-route-page="@(Model.CurrentPage + 1)" 
                   asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder" asp-route-searchTerm="@Model.SearchTerm"
                   class="btn btn-outline-secondary @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">Next</a>
                <a asp-action="FileList" asp-route-creator="@Model.SelectedOperator" asp-route-page="@Model.TotalPages" 
                   asp-route-sortBy="@Model.SortBy" asp-route-sortOrder="@Model.SortOrder" asp-route-searchTerm="@Model.SearchTerm"
                   class="btn btn-outline-secondary @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">Last</a>
            </div>

            <div class="small text-muted">
                Sorting by: <span class="fw-bold">@Model.SortBy</span> (@Model.SortOrder)
            </div>
        </div>

        <!-- Main File List Table -->
        <div class="card shadow-sm mb-4">
            <div class="table-responsive">
                <table class="table table-sm table-hover file-table mb-0">
                    <thead>
                        <tr>
                            <th class="sortable-header" onclick="applySort('FileDesc')">
                                File Name @(Model.SortBy == "FileDesc" ? (Model.SortOrder == "ASC" ? "↑" : "↓") : "")
                            </th>
                            <th class="text-center sortable-header" onclick="applySort('FileDate')">
                                Date @(Model.SortBy == "FileDate" ? (Model.SortOrder == "ASC" ? "↑" : "↓") : "")
                            </th>
                            <th class="text-center sortable-header" onclick="applySort('FileQty')">
                                Quantity @(Model.SortBy == "FileQty" ? (Model.SortOrder == "ASC" ? "↑" : "↓") : "")
                            </th>
                            <th style="width: 100px;" class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var set in Model.FileSets)
                        {
                            <tr class='@(Model.SelectedFileSet.FileNumber == set.FileNumber ? "table-primary" : "")'>
                                <td>
                                    <a asp-action="QueryFile" asp-route-id="@set.FileNumber" class="text-decoration-none fw-bold">
                                        <i class="bi bi-folder2-open me-2"></i>@set.FileDesc
                                    </a>
                                </td>
                                <td class="text-center small text-muted">@(set.FileDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@set.FileQty</span></td>
                                <td class="text-center">
                                    <form asp-action="SelectFileSet" method="post">
                                        <input type="hidden" name="fileNumber" value="@set.FileNumber" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm px-3">Select</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Edit Section & General Reading List -->
        <div class="row">
            <!-- Borrower File Details -->
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light py-2"><h6 class="mb-0 small fw-bold">Borrower File Details</h6></div>
                    <div class="card-body p-3">
                        <form id="editForm" asp-action="UpdateFileSet" method="post">
                            <input type="hidden" asp-for="SelectedFileSet.FileNumber" />
                            <div class="mb-2">
                                <label class="small fw-bold">File Name</label>
                                <input asp-for="SelectedFileSet.FileDesc" class="form-control form-control-sm" required />
                            </div>
                            <div class="mb-2">
                                <label class="small fw-bold">Permissions</label>
                                <select asp-for="SelectedFileSet.FileOperAccess" class="form-select form-select-sm">
                                    <option value="N">Only Me (NONE)</option>
                                    <option value="A">Allow Others (FULL)</option>
                                    <option value="G">Global (GLOBAL)</option>
                                </select>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- General Reading List Table -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 small fw-bold">General Reading List Relationship</h6>
                        <span class="text-muted" style="font-size: 0.7rem;">Double-click to link/unlink catalog lists</span>
                    </div>
                    <div class="table-responsive" style="max-height: 300px;">
                        <form id="readingListForm" asp-action="SaveReadingListLinks" method="post">
                            <input type="hidden" name="borrowerFileNumber" value="@Model.SelectedFileSet.FileNumber" />
                            <table class="table table-sm table-hover reading-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Catalog File Name</th>
                                        <th style="width: 150px;">Expiry Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cat in Model.GeneralReadingLists)
                                    {
                                        var link = Model.RelatedReadingListLinks.FirstOrDefault(l => l.FileNumberCat == cat.FileNumber);
                                        var isSelected = link != null;
                                        <tr class="reading-row @(isSelected ? "selected-row" : "")" 
                                            ondblclick="toggleReadingList(this, @cat.FileNumber)">
                                            <td>
                                                <input type="checkbox" name="selectedCatFileNumbers" value="@cat.FileNumber" 
                                                       class="d-none reading-check" @(isSelected ? "checked" : "") />
                                                @cat.FileDesc
                                            </td>
                                            <td>
                                                <input type="date" name="expiryDates" class="form-control form-control-sm h-auto py-0" 
                                                       value='@(isSelected ? link.ExpirationDate.ToString("yyyy-MM-dd") : "")' />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterByCreator(creator) {
            window.location.href = '@Url.Action("FileList")' + '?creator=' + encodeURIComponent(creator);
        }

        function applySearch(term) {
            const url = new URL(window.location.href);
            url.searchParams.set('searchTerm', term);
            url.searchParams.set('page', '1'); // Reset to page 1 on search
            window.location.href = url.toString();
        }

        function applySort(field) {
            const url = new URL(window.location.href);
            const currentSort = url.searchParams.get('sortBy') || 'FileDesc';
            const currentOrder = url.searchParams.get('sortOrder') || 'ASC';
            
            let nextOrder = 'ASC';
            if (currentSort === field && currentOrder === 'ASC') {
                nextOrder = 'DESC';
            }
            
            url.searchParams.set('sortBy', field);
            url.searchParams.set('sortOrder', nextOrder);
            url.searchParams.set('page', '1');
            window.location.href = url.toString();
        }

        function toggleReadingList(row, id) {
            const checkbox = row.querySelector('.reading-check');
            checkbox.checked = !checkbox.checked;
            
            if (checkbox.checked) {
                row.classList.add('selected-row');
            } else {
                row.classList.remove('selected-row');
                // Clear the date if unselected
                row.querySelector('input[type="date"]').value = '';
            }
        }
    </script>
}
